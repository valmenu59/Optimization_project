<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="/style.css" rel="stylesheet">
    <title>CPLEX</title>
</head>
<body>
    <div id="data-container" hidden="hidden">
        <%= results %>
    </div>

    <h1>Nurse scheduling problem</h1>

    <div id="div_select_result">
        <label for="select_result">Please to choose the result from file :</label>
        <select id="select_result" name="select_result"></select>
    </div>

    <script>
        const all_results = <%- JSON.stringify(results) %>;
        const select_result = document.querySelector("#select_result");

        const shift_labels = ["Morning", "Afternoon", "Night"];


        select_result.addEventListener("change", (e) => {
            const selectedIndex = e.target.value;

            all_results.forEach((_, index) => {
                let container = document.getElementById("result_container_" + index);
                if (container) {
                    if (String(index + 1) === selectedIndex) {
                        container.style.display = "block";
                    } else {
                        container.style.display = "none";
                    }
                }
            });
        });

        console.log("Data got :\n", all_results);

        all_results.forEach((results, index) => {
            console.log(results, index)

            let option = document.createElement("option");
            option.text = "Result n°" + (index + 1);
            option.value = index + 1;
            select_result.appendChild(option);

            let result_schedule = document.createElement("div");
            result_schedule.id = "result_container_" + index;
            result_schedule.style.display = index === 0 ? "block" : "none";

            let file_name = document.createElement("h2");
            file_name.textContent = "Results from the file n°" + (index + 1);
            result_schedule.appendChild(file_name);

            if (results){
                results.forEach((result) => {
                    let employeeId = result[0];
                    let schedule = result[1];

                    let employee = document.createElement("h3");
                    employee.textContent = `Employee ${employeeId}:`;
                    employee.id = "employee_title";
                    result_schedule.appendChild(employee);

                    let table;
                    let headerRow;
                    const days = ["Mon.", "Tue.", "Wed.", "Thu.", "Fri.", "Sat.", "Sun."];
                    let rows;

                    for (let j = 0; j < schedule.length; j += 6) {

                        if ((j / 6) % 7 === 0) {
                            table = document.createElement("table");
                            table.style.marginBottom = "20px";

                            headerRow = document.createElement("tr");
                            headerRow.classList.add("headerDay");

                            // First cell
                            let cornerCell = document.createElement("th");
                            cornerCell.textContent = "";
                            cornerCell.id = "corner"
                            headerRow.appendChild(cornerCell);
                            table.appendChild(headerRow);

                            rows = [];
                            for (let i = 0; i < 3; i++){
                                let shiftRow = document.createElement("tr");

                                // insertion labels Morning, Afternoon, Night
                                let labelCell = document.createElement("td");
                                labelCell.textContent = shift_labels[i];
                                labelCell.classList.add("shift_label");
                                shiftRow.appendChild(labelCell);

                                table.appendChild(shiftRow);
                                rows.push(shiftRow);
                            }

                            result_schedule.appendChild(table);
                        }

                        // header (days)
                        let tdDay = document.createElement("td");
                        tdDay.textContent = `${days[(j / 6) % 7]} (D${(j / 6) + 1})`;
                        tdDay.classList.add("day");
                        if ((j / 6) % 7 === 5 || (j / 6) % 7 === 6) {
                            tdDay.classList.add("weekend");
                        }
                        headerRow.appendChild(tdDay);

                        // shifts
                        for (let i = 0; i < 3; i++){
                            let tdShift = document.createElement("td");
                            if (schedule.charAt(j + i * 2) !== "/"){
                                if (schedule.charAt(j + i * 2) === "*") {
                                    tdShift.textContent = schedule.charAt(j + i * 2 + 1);
                                } else {
                                    tdShift.textContent = schedule.charAt(j + i * 2) + schedule.charAt(j + i * 2 + 1);
                                }

                                tdShift.classList.add("has_shift");
                            } else {
                                tdShift.textContent = "/";
                            }
                            tdShift.classList.add("shift");
                            if ((j / 6) % 7 === 5 || (j / 6) % 7 === 6) {
                                tdShift.classList.add("weekend");
                            }
                            rows[i].appendChild(tdShift);
                        }
                    }
                });

                document.body.appendChild(result_schedule);
            } else {
                let div_no_result = document.createElement("div");
                div_no_result.textContent = "No results found for this file";
                div_no_result.id = "no_result";
                result_schedule.appendChild(div_no_result);

                document.body.appendChild(result_schedule);
            }
        });


    </script>
</body>
</html>